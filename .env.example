# Run npm run setup to create .env with a random dashboard token.
HOST=127.0.0.1
PORT=3210
ADMIN_TOKEN=replace-with-a-long-random-token-at-least-24-characters
DATA_DIR=./data
WORKSPACE_ROOT=./workspaces
MAX_CONCURRENT_JOBS=3
ACCOUNT_COOLDOWN_SECONDS=3600
JOB_TIMEOUT_SECONDS=1800
MAX_JOB_ATTEMPTS=5
# Optional default; leave blank to use the Codex default model.
CODEX_MODEL=
# Optional API accounts: reference the variable NAME when adding an account.
# ChatGPT accounts sign in using npm run account:login -- ACCOUNT_ID
ACCOUNT_PERSONAL_API_KEY=
ACCOUNT_WORK_API_KEY=
